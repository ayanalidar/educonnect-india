# EduConnect India — Environment Variables
# Copy this file to .env and fill in your values

# Database (Neon PostgreSQL — get free tier at neon.tech)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Auth secret (generate with: openssl rand -hex 32)
# Used for HMAC password hashing + token signing
AUTH_SECRET=generate-with-openssl-rand-hex-32

# Z.AI SDK (for LLM, VLM, TTS — powers AI features)
# Get credentials from your z.ai sandbox config or z.ai platform
ZAI_API_KEY=Z.ai
ZAI_BASE_URL=https://internal-api.z.ai/v1
ZAI_TOKEN=your-jwt-token-from-z-ai
ZAI_CHAT_ID=your-chat-id
ZAI_USER_ID=your-user-id

# Payment (Razorpay — get at razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Communication (WhatsApp Business API)
WHATSAPP_BUSINESS_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Email (Resend — get at resend.com)
RESEND_API_KEY=

# SMS (Twilio — get at twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Storage (AWS S3 for document uploads)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Monitoring (Sentry — get at sentry.io)
SENTRY_DSN=

# Analytics (PostHog — get at posthog.com)
POSTHOG_KEY=
