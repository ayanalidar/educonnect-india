# EduConnect India — Environment Variables
# Copy this file to .env and fill in your values

# Database (Neon PostgreSQL recommended — get free tier at neon.tech)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Auth secret (generate with: openssl rand -hex 32)
AUTH_SECRET=your-secret-key-here

# AI API key (z-ai-web-dev-sdk)
ZAI_API_KEY=your-zai-api-key

# Payment (Razorpay — get at razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Communication (WhatsApp Business API)
WHATSAPP_BUSINESS_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Email (Resend — get at resend.com)
RESEND_API_KEY=

# SMS (Twilio — get at twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Storage (AWS S3 for document uploads)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Monitoring (Sentry — get at sentry.io)
SENTRY_DSN=

# Analytics (PostHog — get at posthog.com)
POSTHOG_KEY=
