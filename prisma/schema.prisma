// EduConnect India — full SaaS schema
// Made & maintained by GuardianX

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ Auth ============

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("COUNSELOR") // ADMIN | MANAGER | COUNSELOR | UNIVERSITY
  branch       String?
  phone        String?
  avatarColor  String   @default("#e85d2f")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  students       Student[]
  applications   Application[]
  communications Communication[]
  invoices       Invoice[]
  appointments   Appointment[]
}

// ============ Students ============

model Student {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String
  city            String
  country         String   @default("India")
  targetCountry   String?  // destination
  targetProgram   String?  // e.g. "MS Computer Science"
  intake          String?  // e.g. "Fall 2026"
  budget          Int?     // INR lakhs
  academicScore   Float?   // % or GPA scaled
  englishScore    String?  // "IELTS 7.5" / "TOEFL 105"
  status          String   @default("LEAD") // LEAD | SHORTLISTED | APPLIED | OFFERED | ENROLLED | REJECTED
  source          String?  // "Website" | "Walk-in" | "Referral"
  counselorId     String?
  counselor       User?    @relation(fields: [counselorId], references: [id])
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications    Application[]
  visas           VisaApplication[]
  communications  Communication[]
  documents       DocumentRecord[]
  parentLinks     ParentStudent[]
  deadlines       Deadline[]
  interviewSessions VisaInterviewSession[]
  appointments    Appointment[]
}

// ============ Parent Portal ============

model Parent {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  phone        String?
  avatarColor  String   @default("#0f766e")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  students     ParentStudent[]
  messages     ParentMessage[]
}

model ParentStudent {
  id        String   @id @default(cuid())
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relation  String   @default("PARENT") // PARENT | GUARDIAN
  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
}

model ParentMessage {
  id         String   @id @default(cuid())
  parentId   String
  parent     Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId  String?
  fromRole   String   // PARENT | COUNSELOR
  body       String
  readAt     DateTime?
  createdAt  DateTime @default(now())
}

// ============ Document OCR ============

model DocumentRecord {
  id            String   @id @default(cuid())
  studentId     String?
  student       Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  docType       String   // PASSPORT | TRANSCRIPT | IELTS_CERT | TOEFL_CERT | SOP | LOR | BANK_STATEMENT | RESUME
  fileName      String
  fileSize      Int?
  mimeType      String?
  extractedData String   // JSON string of extracted fields
  summary       String?
  confidence    Float?   @default(0)
  status        String   @default("EXTRACTED") // PENDING | EXTRACTED | VERIFIED | REJECTED
  createdAt     DateTime @default(now())
}

// ============ Scholarships ============

model Scholarship {
  id              String   @id @default(cuid())
  name            String
  provider        String   // e.g. "British Council", "Govt of India", "University of Oxford"
  country         String   // destination country
  amount          Int      // INR per year (in rupees)
  amountLabel     String   // display label e.g. "£10,000", "Full tuition"
  level           String   // UG | PG | PHD | ANY
  categories      String   // comma-separated: MERIT,NEED,MINORITY,SPORTS,RESEARCH
  minScore        Float?   // min academic score (10-scale)
  minIelts        Float?
  minToefl        Int?
  deadline        String?  // e.g. "2026-03-15" or "Rolling"
  intake          String?  // e.g. "Fall 2026"
  fields          String   // comma-separated eligible fields, "ANY" for all
  website         String?
  logoColor       String   @default("#0f766e")
  description     String
  createdAt       DateTime @default(now())
}

// ============ Deadlines ============

model Deadline {
  id            String   @id @default(cuid())
  studentId     String?
  student       Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  applicationId String?  // link to application if relevant
  title         String
  description   String?
  dueDate       DateTime
  priority      String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  category      String   // APPLICATION | VISA | DOCUMENT | PAYMENT | INTERVIEW | SCHOLARSHIP
  country       String?  // for visa/interview deadlines
  status        String   @default("PENDING") // PENDING | DONE | OVERDUE
  escalatedTo   String?  // who's been notified
  createdAt     DateTime @default(now())
}

// ============ Conversational AI Chatbot ============

model ChatConversation {
  id          String   @id @default(cuid())
  sessionId   String   @unique // anonymous browser session
  visitorName String?
  visitorEmail String?
  visitorPhone String?
  source      String   @default("WEBSITE") // WEBSITE | DASHBOARD | WHATSAPP
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    ChatMessage[]
}

model ChatMessage {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String   // USER | ASSISTANT
  content         String
  createdAt       DateTime @default(now())
}

// ============ Visa Interview Practice ============

model VisaInterviewSession {
  id            String   @id @default(cuid())
  studentId     String?
  student       Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  country       String
  universityName String?
  programName   String?
  questions     String   // JSON array of { question, answer, score, feedback }
  overallScore  Float?   @default(0)
  status        String   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============ Calendar & Booking ============

model Appointment {
  id           String   @id @default(cuid())
  studentId    String?
  student      Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  counselorId  String?
  counselor    User?    @relation(fields: [counselorId], references: [id])
  title        String
  description  String?
  startTime    DateTime
  endTime      DateTime
  status       String   @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED | NO_SHOW
  type         String   @default("COUNSELING") // COUNSELING | VISA_INTERVIEW | FOLLOW_UP | DOCUMENT_REVIEW | PARENT_MEETING
  location     String   @default("VIDEO") // IN_PERSON | VIDEO | PHONE
  meetingLink  String?
  branch       String?
  createdAt    DateTime @default(now())
}

// ============ Referrals ============

model Referral {
  id              String   @id @default(cuid())
  code            String   @unique
  referrerName    String
  referrerEmail   String
  referrerPhone   String?
  referrerType    String   @default("ALUMNI") // ALUMNI | PARTNER | STUDENT | AFFILIATE
  refereeName     String?
  refereeEmail    String?
  refereePhone    String?
  status          String   @default("PENDING") // PENDING | CONTACTED | CONVERTED | PAID | LOST
  commissionAmount Float?  @default(0) // INR
  commissionStatus String  @default("NONE") // NONE | DUE | PAID
  convertedStudentId String?
  notes           String?
  createdAt       DateTime @default(now())
  convertedAt     DateTime?
}

// ============ Country Guides ============

model CountryGuide {
  id                String   @id @default(cuid())
  country           String   @unique
  flag              String
  capital           String
  currency          String
  language          String
  visaType          String
  visaProcessingTime String
  visaFee           String
  intakeMonths      String
  avgTuition        String
  avgLivingCost     String
  workWhileStudying String
  postStudyVisa     String
  popularPrograms   String
  topUniversities   String
  description       String
  heroColor         String   @default("#e85d2f")
  createdAt         DateTime @default(now())
}

// ============ Branches ============

model Branch {
  id          String   @id @default(cuid())
  name        String
  city        String
  address     String
  phone       String?
  email       String?
  managerId   String?
  managerName String?
  createdAt   DateTime @default(now())
}

// ============ Lead Magnets ============

model LeadMagnet {
  id          String   @id @default(cuid())
  name        String
  type        String   // ELIGIBILITY_CHECKER | SCHOLARSHIP_QUIZ | UNIVERSITY_MATCHER | COUNTRY_QUIZ | VISA_ELIGIBILITY
  slug        String   @unique
  description String
  ctaText     String   @default("Get my results")
  isActive    Boolean  @default(true)
  views       Int      @default(0)
  conversions Int      @default(0)
  embedCode   String?
  createdAt   DateTime @default(now())
}

// ============ Audit Log (Compliance) ============

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String?
  userName   String?
  action     String   // LOGIN | LOGOUT | CREATE | UPDATE | DELETE | EXPORT | VIEW | ESCALATE
  resource   String   // STUDENT | APPLICATION | VISA | INVOICE | DOCUMENT | USER | SETTINGS
  resourceId String?
  details    String
  ipAddress  String?
  userAgent  String?
  severity   String   @default("INFO") // INFO | WARNING | CRITICAL
  createdAt  DateTime @default(now())
}

// ============ Universities ============

model University {
  id              String   @id @default(cuid())
  name            String   @unique
  country         String
  city            String
  ranking         Int?     // world ranking
  type            String   @default("PUBLIC") // PUBLIC | PRIVATE
  qsStars         Float?   @default(0)
  applicationFee  Int?     // USD
  tuitionFee      Int?     // USD per year
  popularCourses  String   // comma-separated
  intakeMonths    String   // comma-separated
  minIelts        Float?
  minToefl        Int?
  minGpa          Float?
  website         String?
  logoColor       String   @default("#e85d2f")
  partnerStatus   String   @default("DIRECT") // DIRECT | AGENT | PROSPECT
  commission      Float?   @default(0)        // % commission
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications    Application[]
}

// ============ Applications ============

model Application {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  universityId  String
  university    University @relation(fields: [universityId], references: [id])
  counselorId   String?
  counselor     User?    @relation(fields: [counselorId], references: [id])
  program       String
  intake        String
  status        String   @default("DRAFT") // DRAFT | SUBMITTED | UNDER_REVIEW | OFFERED | ACCEPTED | REJECTED | ENROLLED
  amount        Float?   // tuition amount in USD
  submittedAt   DateTime?
  decisionAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoices      Invoice[]
}

// ============ Visa ============

model VisaApplication {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  country         String
  visaType        String   @default("STUDENT") // STUDENT | DEPENDENT | TOURIST
  status          String   @default("DRAFT") // DRAFT | DOCS_READY | SUBMITTED | BIO_METRIC | INTERVIEW | APPROVED | REJECTED
  appointmentDate DateTime?
  decisionDate    DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============ Communication ============

model Communication {
  id           String   @id @default(cuid())
  studentId    String?
  student      Student? @relation(fields: [studentId], references: [id])
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  channel      String   // WHATSAPP | EMAIL | SMS | CALL
  direction    String   @default("OUTBOUND") // INBOUND | OUTBOUND
  subject      String?
  body         String
  status       String   @default("SENT") // SENT | DELIVERED | READ | FAILED
  createdAt    DateTime @default(now())
}

// ============ Finance ============

model Invoice {
  id            String   @id @default(cuid())
  number        String   @unique
  studentName   String
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  counselorId   String?
  counselor     User?    @relation(fields: [counselorId], references: [id])
  amount        Float    // INR
  gst           Float    @default(18)
  status        String   @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE | CANCELLED
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============ Leads (from landing page form) ============

model Lead {
  id           String   @id @default(cuid())
  fullName     String
  consultancy  String?
  email        String
  phone        String
  studentCount String?
  interest     String?
  status       String   @default("NEW") // NEW | CONTACTED | DEMO_SCHEDULED | CONVERTED | LOST
  createdAt    DateTime @default(now())
}
