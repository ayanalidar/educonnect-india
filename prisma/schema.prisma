// EduConnect India — full SaaS schema
// Made & maintained by GuardianX

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ Auth ============

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("COUNSELOR") // ADMIN | MANAGER | COUNSELOR | UNIVERSITY
  branch       String?
  phone        String?
  avatarColor  String   @default("#e85d2f")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  students       Student[]
  applications   Application[]
  communications Communication[]
  invoices       Invoice[]
}

// ============ Students ============

model Student {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String
  city            String
  country         String   @default("India")
  targetCountry   String?  // destination
  targetProgram   String?  // e.g. "MS Computer Science"
  intake          String?  // e.g. "Fall 2026"
  budget          Int?     // INR lakhs
  academicScore   Float?   // % or GPA scaled
  englishScore    String?  // "IELTS 7.5" / "TOEFL 105"
  status          String   @default("LEAD") // LEAD | SHORTLISTED | APPLIED | OFFERED | ENROLLED | REJECTED
  source          String?  // "Website" | "Walk-in" | "Referral"
  counselorId     String?
  counselor       User?    @relation(fields: [counselorId], references: [id])
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications    Application[]
  visas           VisaApplication[]
  communications  Communication[]
  documents       DocumentRecord[]
  parentLinks     ParentStudent[]
}

// ============ Parent Portal ============

model Parent {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  phone        String?
  avatarColor  String   @default("#0f766e")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  students     ParentStudent[]
  messages     ParentMessage[]
}

model ParentStudent {
  id        String   @id @default(cuid())
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relation  String   @default("PARENT") // PARENT | GUARDIAN
  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
}

model ParentMessage {
  id         String   @id @default(cuid())
  parentId   String
  parent     Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId  String?
  fromRole   String   // PARENT | COUNSELOR
  body       String
  readAt     DateTime?
  createdAt  DateTime @default(now())
}

// ============ Document OCR ============

model DocumentRecord {
  id            String   @id @default(cuid())
  studentId     String?
  student       Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  docType       String   // PASSPORT | TRANSCRIPT | IELTS_CERT | TOEFL_CERT | SOP | LOR | BANK_STATEMENT | RESUME
  fileName      String
  fileSize      Int?
  mimeType      String?
  extractedData String   // JSON string of extracted fields
  summary       String?
  confidence    Float?   @default(0)
  status        String   @default("EXTRACTED") // PENDING | EXTRACTED | VERIFIED | REJECTED
  createdAt     DateTime @default(now())
}

// ============ Universities ============

model University {
  id              String   @id @default(cuid())
  name            String   @unique
  country         String
  city            String
  ranking         Int?     // world ranking
  type            String   @default("PUBLIC") // PUBLIC | PRIVATE
  qsStars         Float?   @default(0)
  applicationFee  Int?     // USD
  tuitionFee      Int?     // USD per year
  popularCourses  String   // comma-separated
  intakeMonths    String   // comma-separated
  minIelts        Float?
  minToefl        Int?
  minGpa          Float?
  website         String?
  logoColor       String   @default("#e85d2f")
  partnerStatus   String   @default("DIRECT") // DIRECT | AGENT | PROSPECT
  commission      Float?   @default(0)        // % commission
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications    Application[]
}

// ============ Applications ============

model Application {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  universityId  String
  university    University @relation(fields: [universityId], references: [id])
  counselorId   String?
  counselor     User?    @relation(fields: [counselorId], references: [id])
  program       String
  intake        String
  status        String   @default("DRAFT") // DRAFT | SUBMITTED | UNDER_REVIEW | OFFERED | ACCEPTED | REJECTED | ENROLLED
  amount        Float?   // tuition amount in USD
  submittedAt   DateTime?
  decisionAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoices      Invoice[]
}

// ============ Visa ============

model VisaApplication {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  country         String
  visaType        String   @default("STUDENT") // STUDENT | DEPENDENT | TOURIST
  status          String   @default("DRAFT") // DRAFT | DOCS_READY | SUBMITTED | BIO_METRIC | INTERVIEW | APPROVED | REJECTED
  appointmentDate DateTime?
  decisionDate    DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============ Communication ============

model Communication {
  id           String   @id @default(cuid())
  studentId    String?
  student      Student? @relation(fields: [studentId], references: [id])
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  channel      String   // WHATSAPP | EMAIL | SMS | CALL
  direction    String   @default("OUTBOUND") // INBOUND | OUTBOUND
  subject      String?
  body         String
  status       String   @default("SENT") // SENT | DELIVERED | READ | FAILED
  createdAt    DateTime @default(now())
}

// ============ Finance ============

model Invoice {
  id            String   @id @default(cuid())
  number        String   @unique
  studentName   String
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  counselorId   String?
  counselor     User?    @relation(fields: [counselorId], references: [id])
  amount        Float    // INR
  gst           Float    @default(18)
  status        String   @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE | CANCELLED
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============ Leads (from landing page form) ============

model Lead {
  id           String   @id @default(cuid())
  fullName     String
  consultancy  String?
  email        String
  phone        String
  studentCount String?
  interest     String?
  status       String   @default("NEW") // NEW | CONTACTED | DEMO_SCHEDULED | CONVERTED | LOST
  createdAt    DateTime @default(now())
}
